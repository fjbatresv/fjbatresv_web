{
  "name": "javier-batres-site",
  "version": "1.0.0",
  "private": true,
  "description": "Personal website for Fernando Javier Batres Velásquez (Javier Batres) built with Angular.",
  "scripts": {
    "start": "ng serve --host=127.0.0.1 --port=4300",
    "build": "ng build --configuration production && node scripts/postbuild.mjs && node scripts/check-inline-scripts.mjs && node scripts/check-seo.mjs",
    "test": "ng test --watch=false",
    "test:infra": "node --test infra/*.test.mjs infra/**/*.test.mjs scripts/*.test.mjs",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "test:coverage": "ng test --watch=false --code-coverage",
    "prepare": "husky install"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@angular/animations": "22.3.0",
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/localize": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/platform-browser-dynamic": "22.3.0",
    "@angular/platform-server": "22.3.0",
    "@angular/router": "22.3.0",
    "@angular/ssr": "^22.3.0",
    "@ngx-translate/core": "^18.1.0",
    "@sentry/browser": "^11.18.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "^0.16.3"
  },
  "x-overrides-metadata": {
    "basic-ftp": {
      "reason": "Fixes GHSA-c475-qrg2-pj4r, GHSA-5pm8-86m8-9m6r, and GHSA-r4jh-29pc-gfqr in gitmoji-cli's proxy-agent dependency chain.",
      "introducedOn": "2026-11-25",
      "verifiedOn": "2026-11-25",
      "removeWhen": "gitmoji-cli resolves basic-ftp >= 6.2.4 without an override."
    }
  },
  "overrides": {
    "basic-ftp": "6.2.6"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@sentry/cli": "^3.8.2",
    "@types/jasmine": "~5.1.15",
    "@types/node": "^24.19.4",
    "angular-eslint": "^22.8.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^61.7.1",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^5.5.7",
    "gitmoji-cli": "^9.7.0",
    "husky": "^9.1.7",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.13.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "parse5": "^8.1.1",
    "prettier": "^3.10.1",
    "svgo": "^4.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
